# Variáveis públicas do frontend (Vite) — podem ir para o bundle.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=CHAVE_PUBLICA_ANON_KEY
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_REF
VITE_SUPABASE_ANONYMOUS_SIGNIN=true
VITE_USE_SIGNAL_GATEWAY=true

# ---------------------------------------------------------------------------
# NUNCA coloque valores reais abaixo em .env / .env.example / repositório.
# São apenas nomes esperados pelas Edge Functions, GitHub Actions ou Dashboard
# do Supabase. Use `supabase secrets set`, `supabase secrets list` e os
# Secrets do GitHub Actions (não são exibidos aqui).
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# TRADINGVIEW_WEBHOOK_SECRET=
# B3_WEBHOOK_SECRET=
# Multi-corretoras — simulação por padrão; live exige opt-in explícito.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_ENABLE_LIVE=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSPHRASE=
# OKX_ENABLE_LIVE=
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_API_PASSPHRASE=
# BITGET_ENABLE_LIVE=
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=
# KUCOIN_ENABLE_LIVE=
# GATEIO_API_KEY=
# GATEIO_API_SECRET=
# GATEIO_ENABLE_LIVE=
# Testnets paper: nunca enviam ordem real; nomes aparecem apenas no summary.
# BYBIT_TESTNET_API_KEY=
# BYBIT_TESTNET_API_SECRET=
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# LOVABLE_API_KEY=
